  "sdk_bindings": {
    "transfer_ownership": {
      "QClipboard::setMimeData": [
        0
      ]
    },
    "class_adapters": {
      "QFile": {
        "includes": [
          "src/luau/runtime/scriptfilesystem.h"
        ],
        "factory": "ScriptFileSystem::createScriptFile",
        "guard": "ScriptFileSystem::checkFileAccess",
        "inherited_methods": true,
        "methods": {
          "open": "ScriptFileSystem::openScriptFile"
        },
        "guard_selector": "file_access"
      },
      "QFileDevice": {
        "includes": [
          "src/luau/runtime/scriptfilesystem.h"
        ],
        "guard": "ScriptFileSystem::checkFileDeviceAccess",
        "inherited_methods": true,
        "guard_selector": "file_access"
      },
      "QIODevice": {
        "includes": [
          "src/luau/runtime/scriptfilesystem.h"
        ],
        "guard": "ScriptFileSystem::checkIODeviceAccess",
        "guard_selector": "file_access"
      },
      "QDir": {
        "includes": [
          "src/luau/runtime/scriptfilesystem.h"
        ],
        "guard": "ScriptFileSystem::checkDirectoryAccess",
        "guard_selector": "directory_access"
      },
      "QAbstractSocket": {
        "inherited_methods": true,
        "context_owned": true,
        "constructible": false
      },
      "QTcpSocket": {
        "inherited_methods": true,
        "context_owned": true
      },
      "QTcpServer": {
        "inherited_methods": true,
        "context_owned": true
      },
      "QUdpSocket": {
        "inherited_methods": true,
        "context_owned": true
      },
      "QSslSocket": {
        "inherited_methods": true,
        "context_owned": true
      },
      "QSslServer": {
        "inherited_methods": true,
        "context_owned": true,
        "return_types": {
          "nextPendingConnection": "QSslSocket *"
        }
      },
      "QLocalSocket": {
        "inherited_methods": true,
        "context_owned": true
      },
      "QLocalServer": {
        "inherited_methods": true,
        "context_owned": true,
        "includes": [
          "src/luau/runtime/scriptfilesystem.h"
        ],
        "guard": "ScriptFileSystem::checkResourceAccess",
        "guard_selector": "local_endpoint_access"
      }
    },
    "modules": {
      "filesystem": {
        "file": "QFile",
        "fileinfo": "QFileInfo",
        "dir": "QDir"
      },
      "network": {
        "abstract_socket": "QAbstractSocket",
