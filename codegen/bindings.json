        "ssl_certificate": "QSslCertificate",
        "ssl_key": "QSslKey",
        "ssl_error": "QSslError",
        "ssl_cipher": "QSslCipher"
      }
    },
    "type_annotations": {
      "qint64": {
        "argument": "number | integer",
        "result": "integer"
      },
      "qlonglong": {
        "argument": "number | integer",
        "result": "integer"
      },
      "long long": {
        "argument": "number | integer",
        "result": "integer"
      },
      "quint64": {
        "argument": "number | integer | _qtluau_QVariant",
        "result": "integer | _qtluau_QVariant"
      },
      "qulonglong": {
        "argument": "number | integer | _qtluau_QVariant",
        "result": "integer | _qtluau_QVariant"
      },
      "unsigned long long": {
        "argument": "number | integer | _qtluau_QVariant",
        "result": "integer | _qtluau_QVariant"
      },
      "QByteArray": {
        "argument": "string | bytearray",
        "result": "string"
      },
      "qintptr": {
        "argument": "number | integer",
        "result": "integer"
      },
      "quintptr": {
        "argument": "number | integer | _qtluau_QVariant",
        "result": "integer | _qtluau_QVariant"
      }
    },
    "guard_selectors": {
      "file_access": {
        "const": "ScriptFileSystem::Access::Read",
        "mutable": "ScriptFileSystem::Access::Unknown",
        "rules": [
          {
            "methods": [
              "remove",
              "rename",
              "moveToTrash",
              "setPermissions",
              "setFileTime"
            ],
            "value": "ScriptFileSystem::Access::Remove"
          },
          {
            "methods": [
              "write",
              "putChar",
              "resize"
            ],
            "value": "ScriptFileSystem::Access::Write"
          },
          {
            "methods": [
              "tr",
              "exists",
              "encodeName",
              "decodeName",
              "symLinkTarget",
              "permissions",
              "supportsMoveToTrash",
              "unsetError",
              "setCurrentReadChannel",
              "setCurrentWriteChannel",
              "open",
              "close",
              "flush",
              "copy",
              "link",
              "setFileName",
              "read",
              "readAll",
              "readLine",
              "readLineInto",
              "getChar",
              "peek",
              "skip",
              "seek",
              "reset",
              "setTextModeEnabled",
              "startTransaction",
              "commitTransaction",
              "rollbackTransaction",
              "ungetChar",
              "waitForReadyRead",
              "waitForBytesWritten"
            ],
            "value": "ScriptFileSystem::Access::Read"
          }
        ]
      },
      "directory_access": {
        "const": "ScriptFileSystem::Access::Read",
        "mutable": "ScriptFileSystem::Access::Remove",
        "rules": [
          {
            "methods": [
              "remove",
              "rmdir",
              "rmpath",
              "rename",
              "removeRecursively",
              "setCurrent",
              "setSearchPaths",
              "addSearchPath"
            ],
            "value": "ScriptFileSystem::Access::Remove"
          },
          {
            "methods": [
              "current",
              "currentPath",
              "home",
              "homePath",
              "root",
              "rootPath",
              "temp",
              "tempPath",
              "drives",
              "searchPaths",
              "separator",
              "listSeparator",
              "isAbsolutePath",
              "isRelativePath",
              "toNativeSeparators",
              "fromNativeSeparators",
              "cleanPath",
              "match",
              "nameFiltersFromString",
              "mkdir",
              "mkpath",
              "cd",
              "cdUp",
              "setPath",
              "setFilter",
              "setNameFilters",
              "setSorting",
              "refresh",
              "makeAbsolute",
              "swap"
            ],
            "value": "ScriptFileSystem::Access::Read"
          }
        ]
      },
      "local_endpoint_access": {
        "const": "ScriptFileSystem::Access::Read",
        "mutable": "ScriptFileSystem::Access::Read",
        "rules": [
          {
            "methods": [
              "removeServer"
            ],
            "value": "ScriptFileSystem::Access::Remove"
          }
        ]
      }
    },
    "module_dependencies": {
      "network": {
        "sdk_modules": [
          "QtNetwork"
