{
  "common": {
    "types": {
      "QString": {
        "alias": "ustring",
        "enabled": true,
        "methods": [
          "*"
        ],
        "metamethods": {
          "__tostring": "toStdString"
        }
      },
      "QByteArray": {
        "alias": "bytearray",
        "enabled": true,
        "methods": [
          "*"
        ]
      },
      "QVariant": {
        "alias": "variant",
        "enabled": true,
        "methods": [
          "*"
        ]
      },
      "QColor": {
        "alias": "color",
        "enabled": true,
        "methods": [
          "*"
        ]
      }
    }
  },
