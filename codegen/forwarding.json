{
  "preamble": [
    "// Generated body of the host API registration function.",
    "const QPointer<MainWindow> window(m_win);",
    "auto scriptContexts = std::make_shared<ScriptDocumentRegistry>([window]() -> EditorView * { return window ? window->currentEditor() : nullptr; }, [this](const QUrl &file, EditorView **view) -> int { return openDocument(file, view); }, [this](EditorView *view, bool force) -> int { return closeDocument(view, force); });"
  ],
  "default_body": "auto *view = scriptContext->view(); if (!view) { return $fallback; } return view->$native(this$comma_arguments);",
  "groups": {
    "log": {
      "body": "$return_prefix this->$native(scriptContext->sender()$comma_arguments);"
    },
    "toast": {
      "body": "$return_prefix this->$native(scriptContext->sender()$comma_arguments);"
    },
    "service": {
      "body": "$return_prefix this->$native(scriptContext->sender()$comma_arguments);"
    }
  },
  "method_rules": {
    "switchDocument": {
      "body": "return scriptContext->switchDocument($arguments);"
    },
    "raiseDocument": {
      "body": "return scriptContext->raiseDocument($arguments);"
    },
    "openFile": {
      "body": "return scriptContext->openFile($arguments);"
    },
    "documentInfo": {
      "body": "return scriptContext->documentInfo($arguments);"
    },
    "closeFile": {
      "body": "return scriptContext->closeFile($arguments);"
    },
    "openCurrent": {
      "body": "return scriptContext->openCurrent($arguments);"
    },
    "closeCurrent": {
      "body": "return scriptContext->closeCurrent($arguments);"
    },
    "beginMarco": {
      "body": "return scriptContext->beginMacro($arguments);"
    },
    "endMarco": {
      "body": "return scriptContext->endMacro($arguments);"
    },
    "isMacroEmpty": {
      "body": "return scriptContext->isMacroEmpty($arguments);"
    },
    "resetMarco": {
      "body": "return scriptContext->resetMacro($arguments);"
    },
    "isCurrentDocEditing": {
      "body": "return scriptContext->view() != nullptr;"
    },
    "foreground": {
      "native": "metadata",
      "arguments": [
        "arg0",
        "arg1",
        "arg2",
        "QColor()",
        "QString()"
      ]
    },
    "background": {
      "native": "metadata",
      "arguments": [
        "arg0",
        "arg1",
        "QColor()",
        "arg2",
        "QString()"
      ]
    },
    "comment": {
      "native": "metadata",
      "arguments": [
        "arg0",
        "arg1",
        "QColor()",
        "QColor()",
        "arg2"
      ]
    },
    "invokeScriptService": {
      "body": "return ::invokeScriptService(*this, scriptContext->sender(), $arguments);"
    },
    "closeFileHandle": {
      "body": "return scriptContext->closeFileHandle($arguments);"
    },
    "isFileOpened": {
      "body": "return scriptContext->isFileOpened($arguments);"
    },
    "openedFiles": {
      "body": "return scriptContext->openedFiles();"
    },
    "allOpenedFiles": {
      "body": "return this->allOpenedFiles(scriptContext->sender());"
    }
  },
  "fallbacks": {
    "isReadOnly": "true",
    "isKeepSize": "true",
    "isLocked": "true",
    "findNext": "-1",
    "findPrevious": "-1"
  },
  "assignments": [],
  "output": "generated/host_forwarders.inc",
  "captures": [
    "this",
    "scriptContexts"
  ],
  "private_helpers": [
    {
      "namespace": "ctl",
      "functions": [
        {
          "name": "_document_context",
          "context_method": "token",
          "result": "int"
        },
        {
          "name": "_file_url",
          "native": "WingHex::fileUrl",
          "parameters": [
            "QString"
          ],
          "result": "QUrl"
        },
        {
          "name": "_workspace_url",
          "native": "WingHex::workspaceUrl",
          "parameters": [
            "QString"
          ],
          "result": "QUrl"
        },
        {
          "name": "_device_url",
          "native": "WingHex::deviceUrl",
          "parameters": [
            "QString",
            "QString"
          ],
          "result": "QUrl"
        },
        {
          "name": "_call_sync",
          "native": "LuauUtil::callSync",
          "raw": true
        }
      ]
    }
  ]
}
