local env = require("@s/env")
local icons = require("@s/icons")
local binary = require("@s/binary")
local ffi = require("@b/cffi").new()
local host = require("@b/winghex")
assert(host.env == env and host.StandardIcon.CopyHex == icons.Id.CopyHex)
assert(env.app.name ~= "" and env.app.author == "wingsummer")
assert(type(env.qt.version.major) == "number" and env.qt.version.major >= 6)
assert(table.isfrozen(env) and table.isfrozen(env.app) and table.isfrozen(env.app.version))
assert(not pcall(function() env.locale = "changed" end))
assert(icons.Id.CopyHex == 15 and not pcall(icons.pixmap, icons.Id.CopyHex))
local schema = binary.register("wide-native", { fields = {{name = "u", type = "u64"}, {name = "i", type = "i64", endian = "big"}} })
for _, pair in {{"18446744073709551615", "-9223372036854775808"}, {"0", "9223372036854775807"}, {"9007199254740993", "-1"}} do
    local raw = binary.encode(schema, {u = uint64(pair[1]), i = int64(pair[2])})
    local parsed = binary.decode(schema, raw)
    assert(tostring(parsed.values.u) == pair[1], tostring(parsed.values.u))
    assert(tostring(parsed.values.i) == pair[2], tostring(parsed.values.i))
    assert(binary.encode(schema, parsed.values) == raw)
end
ffi.cdef("typedef struct { uint8_t a; uint32_t b; } WingStdTest;")
local native = binary.register_cffi("abi-native", ffi, "WingStdTest", { fields = {{name = "a", type = "u8"}, {name = "b", type = "u32"}} })
assert(native.size == ffi.sizeof("WingStdTest") and native.fields[2].offset == ffi.offsetof("WingStdTest", "b"))
assert(not pcall(binary.register_cffi, "abi-missing", ffi, "WingStdTest", {fields = {{name = "missing", type = "u8"}}}))
assert(binary.decode(native, binary.encode(native, {a = 7, b = 123456})).values.b == 123456)
println("PASS standard library native host")
