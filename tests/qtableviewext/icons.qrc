<RCC>
    <qresource prefix="/light">
        <file alias="menu.svg">../../theme/light/menu.svg</file>
        <file alias="up-arrow.svg">../../theme/light/up-arrow.svg</file>
        <file alias="down-arrow.svg">../../theme/light/down-arrow.svg</file>
        <file alias="dialog-close.svg">../../theme/light/dialog-close.svg</file>
        <file alias="message-warning.svg">../../theme/light/message-warning.svg</file>
        <file alias="browser-refresh.svg">../../theme/light/browser-refresh.svg</file>
    </qresource>
    <qresource prefix="/dark">
        <file alias="menu.svg">../../theme/dark/menu.svg</file>
        <file alias="up-arrow.svg">../../theme/dark/up-arrow.svg</file>
        <file alias="down-arrow.svg">../../theme/dark/down-arrow.svg</file>
        <file alias="dialog-close.svg">../../theme/dark/dialog-close.svg</file>
        <file alias="message-warning.svg">../../theme/dark/message-warning.svg</file>
        <file alias="browser-refresh.svg">../../theme/dark/browser-refresh.svg</file>
    </qresource>
</RCC>
