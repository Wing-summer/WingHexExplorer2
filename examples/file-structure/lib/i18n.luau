-- Explicit catalog aliases; the standard library does not infer regions.
local catalog = {
    zh = simplified,
    zh_Hant = traditional,
    zh_TW = traditional,
    zh_HK = traditional,
    zh_MO = traditional,
}

function I18n.new(locale)
    return setmetatable({ tr = StandardI18n.create(catalog, locale) }, Methods)
end
function Methods:text(source, ...)
    return self.tr(source, ...)
end

-- Match complete diagnostics, keeping names, offsets and native errors intact.
local diagnostics = {
    { "^File range out of bounds: (.*)$", "File range out of bounds: %s" },
    { "^Unmapped file%-backed RVA (.*)$", "Unmapped file-backed RVA %s" },
    { "^Misaligned (.*) table$", "Misaligned %s table" },
    { "^Unterminated (.*) descriptors$", "Unterminated %s descriptors" },
    { "^Invalid string table reference: (.*)$", "Invalid string table reference: %s" },
    { "^Invalid section entry size: (.*)$", "Invalid section entry size: %s" },
    { "^Unterminated string: (.*)$", "Unterminated string: %s" },
    { "^Cannot annotate (.*)$", "Cannot annotate %s" },
}

function Methods:diagnostic(message)
    local text = tostring(message)
    -- Luau assert/error may prefix the original source filename and line.
    local detail = string.match(text, "^.-:%d+: (.*)$") or text
    if simplified[detail] or traditional[detail] then return self:text(detail) end
    for _, rule in diagnostics do
        local argument = string.match(detail, rule[1])
        if argument then return self:text(rule[2], argument) end
    end
    return detail
end

return I18n
